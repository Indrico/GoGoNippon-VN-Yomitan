{
  "name": "gogonippon-yomitan",
  "version": "0.3.2",
  "private": true,
  "description": "Yomitan dictionary lookup and offline hover furigana for Go! Go! Nippon! (2011)",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "vendor": "python3 scripts/fetch-dependencies.py && node scripts/prepare-vendor.cjs",
    "build:native": "python3 scripts/build-native.py",
    "check:core": "node scripts/check-core.cjs",
    "check:electron": "node scripts/run-electron-check.cjs",
    "check:lifecycle": "node scripts/check-lifecycle.cjs",
    "package:win": "electron-builder --win dir --x64 --publish never",
    "package:release": "python3 scripts/package-release.py",
    "package:dist": "node scripts/build-windows.cjs",
    "package:release:update": "python3 scripts/package-release.py --update-only"
  },
  "dependencies": {
    "kuromoji": "0.1.2"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.gogonippon.yomitan",
    "productName": "GoGoNippon Study",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/kuromoji/build/**/*",
      "!node_modules/kuromoji/demo/**/*",
      "!node_modules/kuromoji/example/**/*",
      "!node_modules/kuromoji/test/**/*",
      "!node_modules/zlibjs/bin/*dev*"
    ],
    "asarUnpack": [
      "node_modules/kuromoji/dict/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/yomitan",
        "to": "yomitan"
      },
      {
        "from": "native/bin",
        "to": "native"
      },
      {
        "from": "profiles",
        "to": "profiles"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      },
      {
        "from": "vendor/minhook-1.3.4/LICENSE.txt",
        "to": "licenses/minhook/LICENSE.txt"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "executableName": "GoGoNippon-Study",
      "signAndEditExecutable": false
    },
    "electronLanguages": [
      "en-US",
      "ja"
    ],
    "compression": "maximum",
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      }
    ],
    "nsis": {
      "artifactName": "GoGoNippon-Study-${version}-Windows-x64-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "GoGoNippon-Study-${version}-Windows-x64-Portable.${ext}"
  },
  "license": "GPL-3.0-or-later",
  "author": "Indrico",
  "repository": {
    "type": "git",
    "url": "https://github.com/Indrico/GoGoNippon-VN-Yomitan.git"
  },
  "homepage": "https://github.com/Indrico/GoGoNippon-VN-Yomitan#readme",
  "bugs": {
    "url": "https://github.com/Indrico/GoGoNippon-VN-Yomitan/issues"
  }
}
